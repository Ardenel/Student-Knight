<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/currentSessionTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="16sp"
        android:textAllCaps="true"
        android:textStyle="bold"

        android:textColor="@color/title_color"
        android:background="@color/title_background"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="30dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="30dp"

        android:text="Working session" />

    <TextView
        android:id="@+id/currentSessionTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="24sp"
        android:textAllCaps="true"
        android:textStyle="bold"

        android:textColor="@color/title_color"
        android:background=""

        app:layout_constraintTop_toTopOf="@id/currentSessionTitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="50dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="30dp"

        android:text="00 : 00"/>

    <TextView
        android:id="@+id/currentSessionNumOfBreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="20sp"
        android:textAllCaps="true"
        android:textStyle="bold"

        android:textColor="@color/title_color"
        android:background=""

        app:layout_constraintTop_toTopOf="@id/currentSessionTotalTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="60dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="30dp"

        android:text="Remaining break : 0"/>

    <TextView
        android:id="@+id/currentSessionTimeBeforeBreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="20sp"
        android:textAllCaps="true"
        android:textStyle="bold"

        android:textColor="@color/title_color"
        android:background=""

        app:layout_constraintTop_toTopOf="@id/currentSessionNumOfBreak"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="30dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="30dp"

        android:text="00 : 00"/>

    <ImageView
        android:id="@+id/currentSessionCharacter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="@id/currentSessionTimeBeforeBreak"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="120dp"

        tools:srcCompat="@tools:sample/avatars" />
    
    <LinearLayout
        android:id="@+id/currentSessionEarnedInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"

        app:layout_constraintTop_toTopOf="@id/currentSessionCharacter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="150dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="30dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"

            android:layout_marginVertical="5dp"
            android:layout_marginHorizontal="10dp">

            <TextView
                android:id="@+id/currentSessionGoldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:paddingHorizontal="5dp"
                android:text="Golds"
                android:textAlignment="center"

                android:textAllCaps="true"

                android:textSize="16sp" />

            <TextView
            android:id="@+id/currentSessionGoldEarned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textAlignment="center"
            android:textSize="12sp"
            android:textAllCaps="true"

            android:paddingHorizontal="5dp"

            android:text="0g"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"

            android:layout_marginVertical="5dp"
            android:layout_marginHorizontal="10dp">

        <TextView
            android:id="@+id/currentSessionXpLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textAlignment="center"
            android:textSize="16sp"
            android:textAllCaps="true"

            android:paddingHorizontal="5dp"

            android:text="Xp"/>

        <TextView
            android:id="@+id/currentSessionXpEarned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textAlignment="center"
            android:textSize="12sp"
            android:textAllCaps="true"

            android:paddingHorizontal="5dp"

            android:text="0xp"/>

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/currentSessionBreakButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/currentSessionEarnedInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:textColor="@color/main_menu_button_text"
        android:background="@color/main_menu_button_background"

        android:layout_marginTop="30dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="30dp"

        android:text="Start break" />

    <Button
        android:id="@+id/currentSessionEndButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/currentSessionBreakButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:textColor="@color/main_menu_button_text"
        android:background="@color/main_menu_button_background"

        android:textSize="12dp"

        android:layout_marginTop="30dp"
        android:paddingHorizontal="10dp"

        android:text="Anticiped End" />


</androidx.constraintlayout.widget.ConstraintLayout>